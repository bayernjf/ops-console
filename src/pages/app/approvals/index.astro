---
import ConsoleLayout from '../../../layouts/ConsoleLayout.astro';
import ApprovalList from '../../../islands/ApprovalList';
import { getContext } from '../../../server/context.js';
import { listApprovals } from '../../../server/approvals-service.js';
import type { DecisionRecord } from '../../../server/upstream/types.js';

const session = Astro.locals.session!;
let initial: DecisionRecord[] = [];
let loadError: string | null = null;
try {
  initial = await listApprovals(getContext());
} catch (thrown) {
  // Fail-closed: show the empty state; the island surfaces the same error.
  loadError = thrown instanceof Error ? thrown.message : String(thrown);
}
const refreshMs = getContext().config.notify.listRefreshMs;
---
<ConsoleLayout title="审批工作台" session={session}>
  {loadError ? (
    <div class="panel panel--error">
      <p>上游暂时不可达（zeus 未响应），列表加载失败：{loadError}</p>
      <p class="hint">页面已 fail-closed，不会展示过期缓存。</p>
    </div>
  ) : null}
  <ApprovalList client:load initial={initial} refreshMs={refreshMs} />
</ConsoleLayout>
<style>
  .panel { padding: 16px; border: var(--hair); border-radius: 8px; background: var(--steel-850); }
  .panel--error { border-color: var(--alert); }
  .hint { color: var(--ink-dim); font-size: 12px; }
</style>
