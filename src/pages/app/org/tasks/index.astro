---
import ConsoleLayout from '../../../../layouts/ConsoleLayout.astro';
import OrgTaskQueue from '../../../../islands/OrgTaskQueue';
import { getContext } from '../../../../server/context.js';
import { loadOrgSnapshot, sortOrgQueue } from '../../../../server/org-service.js';
import { canViewOrg } from '../../../../server/rbac.js';
import type { OrgSnapshot } from '../../../../server/upstream/types.js';

const session = Astro.locals.session!;
const allowed = canViewOrg(session.role);

// Tier0 org M2 F2.2: queue page. SSR seeds the table; the island polls the BFF
// so status changes show up without a reload.
let snapshot: OrgSnapshot | null = null;
let loadError: string | null = null;
const orgFilter = Astro.url.searchParams.get('organization_id') ?? undefined;
if (allowed) {
  try {
    snapshot = await loadOrgSnapshot(getContext(), orgFilter);
  } catch (thrown) {
    loadError = thrown instanceof Error ? thrown.message : String(thrown);
  }
}

const org = snapshot?.organizations.find(o => o.id === (orgFilter ?? snapshot?.organizations[0]?.id)) ?? null;
const initialTasks = sortOrgQueue(snapshot?.tasks ?? []);
const positionNames: Record<string, string> = {};
for (const position of snapshot?.positions ?? []) positionNames[position.id] = `${position.name}`;
const refreshMs = getContext().config.notify.listRefreshMs;
---

<ConsoleLayout title="任务队列" session={session}>
  {!allowed ? (
    <div class="panel">
      <p class="hint">任务队列需要运营角色（owner/operator）。当前角色 {session.role} 不可见。</p>
    </div>
  ) : loadError ? (
    <div class="panel panel--error">
      <p>上游暂时不可达（zeus 未响应），任务加载失败：{loadError}</p>
      <p class="hint">页面已 fail-closed，不会展示过期缓存。</p>
    </div>
  ) : (
    <>
      <div class="toolbar">
        <h1>{org?.name ?? '组织'} · 任务队列</h1>
        <a class="link" href="/app/org">← 花名册</a>
      </div>
      <OrgTaskQueue
        client:load
        initial={initialTasks}
        positionNames={positionNames}
        refreshMs={refreshMs}
        organizationId={org?.id ?? ''}
      />
    </>
  )}
</ConsoleLayout>

<style>
  .toolbar { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
  .toolbar h1 { font-size: 18px; margin: 0; }
  .link { color: var(--data); font-size: 13px; text-decoration: none; }
  .link:hover { text-decoration: underline; }
  .panel { padding: 16px; border: var(--hair); border-radius: 8px; background: var(--steel-850); }
  .panel--error { border-color: var(--alert); }
  .hint { color: var(--ink-dim); font-size: 12px; margin: 0; }
</style>
