---
import ConsoleLayout from '../../../layouts/ConsoleLayout.astro';
import { getContext } from '../../../server/context.js';
import { getDashboardMetrics } from '../../../server/dashboard-service.js';

const session = Astro.locals.session!;

let content: any[] = [];
let published = 0;
let loadError = '';
try {
  const ctx = getContext();
  [content, published] = await Promise.all([
    ctx.commerce.listContent().then((r) => r.content as any[]),
    getDashboardMetrics(ctx).then((m) => m.content.published),
  ]);
} catch (thrown) {
  loadError = thrown instanceof Error ? thrown.message : String(thrown);
}

function fmt(iso?: string): string {
  if (!iso) return '—';
  const d = new Date(iso);
  return Number.isNaN(d.getTime()) ? iso : d.toLocaleString('zh-CN', { hour12: false });
}
---
<ConsoleLayout title="内容" session={session}>
  {loadError ? <div class="panel panel--error"><p>上游不可达：{loadError}</p></div> : null}

  <p class="hint gap-note">
    说明：本页读取 commerce 只读投影 <code>GET /api/v1/content</code>（product.listed 事件）。
    仅含<b>已发布</b>内容；待审（pending/awaiting_approval）上架不在列表内，待办以 zeus 审批工作台为准。
  </p>

  <div class="panel">
    <h3>已发布内容（dashboard published = {published}，列表 {content.length} 条）</h3>
    {content.length === 0 ? <p class="hint">暂无已发布内容。</p> : (
      <table class="data-table">
        <thead><tr>
          <th scope="col">内容 ID</th><th scope="col">商品 SPU</th><th scope="col">渠道</th><th scope="col">渠道商品</th>
          <th scope="col">决策</th><th scope="col">发布时间</th>
        </tr></thead>
        <tbody>
          {content.map((c: any) => (
            <tr>
              <td class="mono">{c.id}</td>
              <td class="mono">{c.productId}</td>
              <td>{c.channel}</td>
              <td class="mono">{c.externalProductId}</td>
              <td class="mono">{c.decisionId ?? '—'}</td>
              <td class="mono">{fmt(c.listedAt)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>
</ConsoleLayout>
<style>
  .panel { padding: 14px 18px; border: var(--hair); border-radius: 8px; background: var(--steel-850); margin-bottom: 14px; }
  .panel--error { border-color: var(--alert); }
  .panel h3 { margin: 0 0 10px; font-size: 14px; }
  .hint { color: var(--ink-dim); font-size: 12px; }
  .gap-note { padding: 10px 14px; border: 1px dashed var(--steel-600); border-radius: 8px; background: var(--steel-850); margin-bottom: 14px; }
  .gap-note code { color: var(--ink-faint); }
  .mono { font-family: var(--mono); font-size: 12px; }
  .data-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .data-table th { text-align: left; color: var(--ink-faint); font-size: 12px; padding: 6px 8px; border-bottom: var(--hair); }
  .data-table td { padding: 8px; border-bottom: 1px solid var(--steel-800); vertical-align: top; }
</style>
