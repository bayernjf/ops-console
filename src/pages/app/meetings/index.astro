---
import ConsoleLayout from '../../../layouts/ConsoleLayout.astro';
import { getContext } from '../../../server/context.js';
import { listMeetings, loadMeeting, openClaimIds } from '../../../server/meetings-service.js';
import { meetingsUpstream, type MeetingDocument } from '../../../server/upstream/meetings.js';

const session = Astro.locals.session!;
const config = getContext().config;
const api = meetingsUpstream(config);

const errorText = Astro.url.searchParams.get('error');
const selectedId = Astro.url.searchParams.get('id');

type Summary = {
  id: string;
  topic: string;
  status: string;
  round: number;
  maxRounds: number;
  utterances: number;
  decisions: number;
  updatedAt: string;
};

let meetings: Summary[] = [];
let listError: string | null = null;
let source = 'zeus';
try {
  meetings = (await api.list()).map(meeting => ({
    id: meeting.id,
    topic: meeting.topic,
    status: meeting.status,
    round: meeting.round,
    maxRounds: meeting.maxRounds,
    utterances: meeting.utterances,
    decisions: meeting.decisions,
    updatedAt: meeting.createdAt,
  }));
} catch (thrown) {
  // The local store is the fallback so the page still works when zeus is down;
  // writes, however, only go through zeus (see /api/meetings).
  source = 'local';
  try {
    meetings = (await listMeetings(config)).map(meeting => ({
      id: meeting.id,
      topic: meeting.topic,
      status: meeting.status,
      round: meeting.round,
      maxRounds: meeting.maxRounds,
      utterances: meeting.utterances,
      decisions: meeting.decisions,
      updatedAt: meeting.updatedAt,
    }));
  } catch (inner) {
    listError = inner instanceof Error ? inner.message : String(inner);
  }
}

let detail: MeetingDocument | null = null;
let detailError: string | null = null;
if (selectedId) {
  try {
    detail = await api.get(selectedId);
  } catch (thrown) {
    try {
      const local = await loadMeeting(config, selectedId);
      detail = local as unknown as MeetingDocument;
    } catch (inner) {
      detailError = inner instanceof Error ? inner.message : String(inner);
    }
  }
}

const chosen = new Set<string>();
const rejected = new Set<string>();
if (detail) {
  for (const decision of detail.decisions) {
    decision.chosenClaimIds.forEach(id => chosen.add(id));
    decision.rejectedClaimIds.forEach(id => rejected.add(id));
  }
}
const openClaims = detail ? openClaimIds(detail as never) : [];
const rounds = detail
  ? [...new Set(detail.utterances.map((utterance) => utterance.round))].sort((a, b) => a - b)
  : [];
const allClaims = detail ? detail.utterances.flatMap(utterance => utterance.claims) : [];
---
<ConsoleLayout title="会议" session={session}>
  {errorText ? (
    <div class="panel panel--error"><p>操作未生效：{errorText}</p></div>
  ) : null}
  {listError ? (
    <div class="panel panel--error">
      <p>会议目录读取失败：{listError}</p>
      <p class="hint">检查 <code>OPS_MEETING_DIR</code> 与 zeus 的 <code>ZEUS_MEETING_DIR</code> 是否一致。</p>
    </div>
  ) : (
    <div class="stack">
      <section class="panel">
        <h1>会议</h1>
        <p class="hint">
          数据源：{source === 'zeus' ? 'zeus 会议 API' : '本地 store（zeus API 不可达，只读）'}。
          发起、发言、推进与决策都经 zeus 的协议守卫，console 不直接改 JSON。
        </p>

        <form class="inline-form" method="post" action="/api/meetings">
          <input type="hidden" name="action" value="open" />
          <label>议题 <input name="topic" required placeholder="这次要决定什么" /></label>
          <label>轮次上限
            <select name="maxRounds">
              <option value="1">1</option>
              <option value="2" selected>2</option>
              <option value="3">3</option>
              <option value="4">4</option>
              <option value="5">5</option>
            </select>
          </label>
          <button type="submit">开新会</button>
        </form>

        {meetings.length === 0 ? (
          <p class="empty">还没有会议记录。</p>
        ) : (
          <table>
            <thead>
              <tr><th>议题</th><th>状态</th><th>轮次</th><th>发言</th><th>决策</th><th>时间</th></tr>
            </thead>
            <tbody>
              {meetings.map((meeting) => (
                <tr>
                  <td><a href={`/app/meetings?id=${meeting.id}`}>{meeting.topic}</a></td>
                  <td><span class={'chip chip--' + meeting.status}>{meeting.status}</span></td>
                  <td>{meeting.round} / {meeting.maxRounds}</td>
                  <td>{meeting.utterances}</td>
                  <td>{meeting.decisions}</td>
                  <td class="mono">{meeting.updatedAt.replace('T', ' ').slice(0, 19)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </section>

      {detailError ? (
        <div class="panel panel--error"><p>读取会议失败：{detailError}</p></div>
      ) : null}

      {detail ? (
        <section class="panel">
          <header class="detail-head">
            <h2>{detail.topic}</h2>
            <span class={'chip chip--' + detail.status}>{detail.status}</span>
          </header>
          <p class="hint mono">
            id={detail.id} · 第 {detail.round}/{detail.maxRounds} 轮 · 创建于 {detail.createdAt.replace('T', ' ').slice(0, 19)}
          </p>

          <div class="actions">
            <form method="post" action="/api/meetings">
              <input type="hidden" name="action" value="advance" />
              <input type="hidden" name="id" value={detail.id} />
              <button type="submit">推进到下一轮</button>
            </form>
            <a class="button" href={`/api/meetings/${detail.id}/markdown`}>下载纪要（Markdown）</a>
          </div>

          <h3>发言</h3>
          <form class="stack-form" method="post" action="/api/meetings">
            <input type="hidden" name="action" value="say" />
            <input type="hidden" name="id" value={detail.id} />
            <label>发言人 <input name="speaker" value={session.username} /></label>
            <label>立场
              <select name="stance">
                <option value="propose">propose 提案</option>
                <option value="challenge">challenge 质疑</option>
                <option value="support">support 附议</option>
                <option value="note">note 记录</option>
              </select>
            </label>
            <label>主张正文 <textarea name="claimText" rows="2" placeholder="可留空：纯反驳时只填证据与目标"></textarea></label>
            <label>证据类型
              <select name="evidenceKind">
                <option value="fact">fact</option>
                <option value="observation">observation</option>
                <option value="reference">reference</option>
                <option value="counterexample">counterexample</option>
              </select>
            </label>
            <label>证据引用 <input name="evidenceRef" placeholder="如 evaluate/run:123 或文档路径" /></label>
            {detail.status === 'challenging' ? (
              <fieldset>
                <legend>质疑目标（可多选）</legend>
                {allClaims.map((claim) => (
                  <label class="check">
                    <input type="checkbox" name="rebut" value={claim.id} />
                    <span class="mono">{claim.id}</span> {claim.text}
                  </label>
                ))}
              </fieldset>
            ) : null}
            <button type="submit">记录发言</button>
          </form>

          <h3>决策</h3>
          {detail.decisions.length === 0 ? (
            <p class="empty">尚未决策。收敛后由你在下面这一票决定采纳/否决。</p>
          ) : (
            <ul class="decisions">
              {detail.decisions.map((decision) => (
                <li>
                  <div class="mono">{decision.at.replace('T', ' ').slice(0, 19)} · {decision.by}</div>
                  <div>
                    采纳 <span class="mono">{decision.chosenClaimIds.join(', ') || '—'}</span>
                    · 否决 <span class="mono">{decision.rejectedClaimIds.join(', ') || '—'}</span>
                  </div>
                  <p>{decision.rationale}</p>
                </li>
              ))}
            </ul>
          )}
          <form class="stack-form" method="post" action="/api/meetings">
            <input type="hidden" name="action" value="decide" />
            <input type="hidden" name="id" value={detail.id} />
            <fieldset>
              <legend>逐条裁决</legend>
              {allClaims.map((claim) => (
                <div class="check-row">
                  <span><span class="mono">{claim.id}</span> {claim.text}</span>
                  <label class="check"><input type="checkbox" name="chosen" value={claim.id} /> 采纳</label>
                  <label class="check"><input type="checkbox" name="rejected" value={claim.id} /> 否决</label>
                </div>
              ))}
            </fieldset>
            <label>理由（必填） <textarea name="rationale" rows="2" required placeholder="为什么这么选；被否方案的理由一并写下"></textarea></label>
            <button type="submit">提交决策</button>
          </form>

          <h3>时间线</h3>
          {rounds.map((round) => (
            <div class="round">
              <h4>第 {round} 轮</h4>
              <ul class="utterances">
                {detail.utterances
                  .filter((utterance) => utterance.round === round)
                  .map((utterance) => (
                    <li>
                      <div class="mono">
                        {utterance.at.replace('T', ' ').slice(0, 19)} · {utterance.speakerId}
                        <span class="chip chip--stance">{utterance.stance}</span>
                        {utterance.rebuts.length > 0 ? (
                          <span class="hint"> 反驳 {utterance.rebuts.join(', ')}</span>
                        ) : null}
                      </div>
                      {utterance.claims.length === 0 ? (
                        <p class="hint">（无新主张，纯反驳）</p>
                      ) : (
                        <ul class="claims">
                          {utterance.claims.map((claim) => (
                            <li>
                              <span class="mono">{claim.id}</span> {claim.text}
                              {chosen.has(claim.id) ? <span class="chip chip--chosen">采纳</span> : null}
                              {rejected.has(claim.id) ? <span class="chip chip--rejected">否决</span> : null}
                              {claim.evidence.length > 0 ? (
                                <div class="hint">证据：{claim.evidence.map((item) => `${item.kind}:${item.ref}`).join('; ')}</div>
                              ) : (
                                <div class="hint">（无证据）</div>
                              )}
                            </li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}
              </ul>
            </div>
          ))}

          <h3>悬置主张</h3>
          {openClaims.length === 0 ? (
            <p class="empty">没有"被反驳但未裁决"的主张。</p>
          ) : (
            <p class="mono">{openClaims.join(', ')} — 被反驳过，但决策没有引用。</p>
          )}
        </section>
      ) : null}
    </div>
  )}
</ConsoleLayout>

<style>
  .stack { display: flex; flex-direction: column; gap: 16px; }
  .panel { padding: 16px; border: var(--hair); border-radius: 8px; background: var(--steel-850); }
  .panel--error { border-color: var(--alert); }
  h1 { font-size: 16px; margin: 0 0 8px; }
  h2 { font-size: 15px; margin: 0; }
  h3 { font-size: 13px; margin: 18px 0 8px; color: var(--ink-dim); text-transform: uppercase; letter-spacing: 0.04em; }
  h4 { font-size: 13px; margin: 12px 0 6px; }
  .hint { color: var(--ink-dim); font-size: 12px; margin: 0 0 8px; }
  .empty { color: var(--ink-dim); font-size: 13px; }
  .mono { font-family: var(--mono, ui-monospace, monospace); font-size: 12px; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th, td { text-align: left; padding: 8px; border-bottom: var(--hair); }
  td a { color: var(--data); text-decoration: none; }
  .detail-head { display: flex; align-items: center; gap: 8px; }
  .chip { display: inline-block; padding: 1px 6px; margin-left: 6px; border-radius: 999px; font-size: 11px; border: var(--hair); }
  .chip--decided { border-color: var(--data); color: var(--data); }
  .chip--chosen { border-color: var(--ok, #2f9e44); color: var(--ok, #2f9e44); }
  .chip--rejected { border-color: var(--alert); color: var(--alert); }
  .chip--converging { border-color: var(--warn, #d9480f); color: var(--warn, #d9480f); }
  .decisions, .utterances, .claims { margin: 0; padding-left: 18px; font-size: 13px; }
  .decisions li, .utterances li { margin-bottom: 10px; }
  .claims { padding-left: 16px; margin-top: 6px; }
  .round { border-left: 2px solid var(--steel-800); padding-left: 10px; }
  .inline-form { display: flex; flex-wrap: wrap; gap: 10px; align-items: end; margin: 12px 0; font-size: 13px; }
  .inline-form input, .stack-form input, .stack-form select, .stack-form textarea {
    background: transparent; border: var(--hair); border-radius: 4px; color: inherit;
    font: inherit; padding: 4px 6px;
  }
  .stack-form { display: flex; flex-direction: column; gap: 8px; font-size: 13px; margin-bottom: 12px; }
  .stack-form label, .inline-form label { display: flex; flex-direction: column; gap: 4px; }
  .check { flex-direction: row !important; align-items: center; gap: 6px; }
  .check-row { display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap; }
  fieldset { border: var(--hair); border-radius: 4px; padding: 8px; }
  button { padding: 5px 12px; border-radius: 4px; border: var(--hair); background: var(--steel-800); color: inherit; font: inherit; cursor: pointer; }
  button:hover, .button:hover { background: var(--steel-700, var(--steel-800)); }
  .button { display: inline-block; padding: 5px 12px; border-radius: 4px; border: var(--hair); background: var(--steel-800); color: inherit; text-decoration: none; font-size: 13px; }
  .actions { display: flex; gap: 8px; }
</style>
