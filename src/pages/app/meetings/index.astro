---
import ConsoleLayout from '../../../layouts/ConsoleLayout.astro';
import { getContext } from '../../../server/context.js';
import {
  listMeetings,
  loadMeeting,
  openClaimIds,
  type MeetingDocument,
} from '../../../server/meetings-service.js';

const session = Astro.locals.session!;
const config = getContext().config;

let meetings: Awaited<ReturnType<typeof listMeetings>> = [];
let listError: string | null = null;
try {
  meetings = await listMeetings(config);
} catch (thrown) {
  listError = thrown instanceof Error ? thrown.message : String(thrown);
}

const selectedId = Astro.url.searchParams.get('id');
let detail: MeetingDocument | null = null;
let detailError: string | null = null;
if (selectedId) {
  try {
    detail = await loadMeeting(config, selectedId);
  } catch (thrown) {
    detailError = thrown instanceof Error ? thrown.message : String(thrown);
  }
}

const decided = new Set<string>();
const rejected = new Set<string>();
const chosen = new Set<string>();
if (detail) {
  for (const decision of detail.decisions) {
    for (const id of decision.chosenClaimIds) {
      chosen.add(id);
      decided.add(id);
    }
    for (const id of decision.rejectedClaimIds) {
      rejected.add(id);
      decided.add(id);
    }
  }
}
const openClaims = detail ? openClaimIds(detail) : [];
const rounds = detail
  ? [...new Set(detail.utterances.map((utterance) => utterance.round))].sort((a, b) => a - b)
  : [];
---
<ConsoleLayout title="会议回放" session={session}>
  {listError ? (
    <div class="panel panel--error">
      <p>会议目录读取失败：{listError}</p>
      <p class="hint">检查 <code>OPS_MEETING_DIR</code> 是否指向 zeus 的 meeting store。</p>
    </div>
  ) : (
    <div class="stack">
      <section class="panel">
        <h1>会议</h1>
        <p class="hint">
          只读回放：数据来自本地 meeting store（<code>OPS_MEETING_DIR</code>）。发起、发言与决策在 zeus
          侧完成（<code>npm run meeting</code>）。
        </p>
        {meetings.length === 0 ? (
          <p class="empty">还没有会议记录。先在 zeus 里 <code>npm run meeting -- open --topic ...</code>。</p>
        ) : (
          <table>
            <thead>
              <tr><th>议题</th><th>状态</th><th>轮次</th><th>发言</th><th>决策</th><th>最后更新</th></tr>
            </thead>
            <tbody>
              {meetings.map((meeting) => (
                <tr>
                  <td><a href={`/app/meetings?id=${meeting.id}`}>{meeting.topic}</a></td>
                  <td><span class={'chip chip--' + meeting.status}>{meeting.status}</span></td>
                  <td>{meeting.round} / {meeting.maxRounds}</td>
                  <td>{meeting.utterances}</td>
                  <td>{meeting.decisions}</td>
                  <td class="mono">{meeting.updatedAt.replace('T', ' ').slice(0, 19)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </section>

      {detailError ? (
        <div class="panel panel--error"><p>读取会议失败：{detailError}</p></div>
      ) : null}

      {detail ? (
        <section class="panel">
          <header class="detail-head">
            <h2>{detail.topic}</h2>
            <span class={'chip chip--' + detail.status}>{detail.status}</span>
          </header>
          <p class="hint mono">
            id={detail.id} · 第 {detail.round}/{detail.maxRounds} 轮 · 创建于 {detail.createdAt.replace('T', ' ').slice(0, 19)}
          </p>

          <h3>决策</h3>
          {detail.decisions.length === 0 ? (
            <p class="empty">尚未决策。收敛后由你在 zeus 侧 <code>decide</code>。</p>
          ) : (
            <ul class="decisions">
              {detail.decisions.map((decision) => (
                <li>
                  <div class="mono">{decision.at.replace('T', ' ').slice(0, 19)} · {decision.by}</div>
                  <div>
                    采纳 <span class="mono">{decision.chosenClaimIds.join(', ') || '—'}</span>
                    · 否决 <span class="mono">{decision.rejectedClaimIds.join(', ') || '—'}</span>
                  </div>
                  <p>{decision.rationale}</p>
                </li>
              ))}
            </ul>
          )}

          <h3>时间线</h3>
          {rounds.map((round) => (
            <div class="round">
              <h4>第 {round} 轮</h4>
              <ul class="utterances">
                {detail.utterances
                  .filter((utterance) => utterance.round === round)
                  .map((utterance) => (
                    <li>
                      <div class="mono">
                        {utterance.at.replace('T', ' ').slice(0, 19)} · {utterance.speakerId}
                        <span class="chip chip--stance">{utterance.stance}</span>
                        {utterance.rebuts.length > 0 ? (
                          <span class="hint"> 反驳 {utterance.rebuts.join(', ')}</span>
                        ) : null}
                      </div>
                      {utterance.claims.length === 0 ? (
                        <p class="hint">（无新主张，纯反驳）</p>
                      ) : (
                        <ul class="claims">
                          {utterance.claims.map((claim) => (
                            <li>
                              <span class="mono">{claim.id}</span> {claim.text}
                              {chosen.has(claim.id) ? <span class="chip chip--chosen">采纳</span> : null}
                              {rejected.has(claim.id) ? <span class="chip chip--rejected">否决</span> : null}
                              {claim.evidence.length > 0 ? (
                                <div class="hint">
                                  证据：{claim.evidence.map((item) => `${item.kind}:${item.ref}`).join('; ')}
                                </div>
                              ) : (
                                <div class="hint">（无证据）</div>
                              )}
                            </li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}
              </ul>
            </div>
          ))}

          <h3>悬置主张</h3>
          {openClaims.length === 0 ? (
            <p class="empty">没有"被反驳但未裁决"的主张。</p>
          ) : (
            <p class="mono">{openClaims.join(', ')} — 被反驳过，但决策没有引用。</p>
          )}
        </section>
      ) : null}
    </div>
  )}
</ConsoleLayout>

<style>
  .stack { display: flex; flex-direction: column; gap: 16px; }
  .panel { padding: 16px; border: var(--hair); border-radius: 8px; background: var(--steel-850); }
  .panel--error { border-color: var(--alert); }
  h1 { font-size: 16px; margin: 0 0 8px; }
  h2 { font-size: 15px; margin: 0; }
  h3 { font-size: 13px; margin: 18px 0 8px; color: var(--ink-dim); text-transform: uppercase; letter-spacing: 0.04em; }
  h4 { font-size: 13px; margin: 12px 0 6px; }
  .hint { color: var(--ink-dim); font-size: 12px; margin: 0 0 8px; }
  .empty { color: var(--ink-dim); font-size: 13px; }
  .mono { font-family: var(--mono, ui-monospace, monospace); font-size: 12px; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th, td { text-align: left; padding: 8px; border-bottom: var(--hair); }
  td a { color: var(--data); text-decoration: none; }
  .detail-head { display: flex; align-items: center; gap: 8px; }
  .chip { display: inline-block; padding: 1px 6px; margin-left: 6px; border-radius: 999px; font-size: 11px; border: var(--hair); }
  .chip--decided { border-color: var(--data); color: var(--data); }
  .chip--chosen { border-color: var(--ok, #2f9e44); color: var(--ok, #2f9e44); }
  .chip--rejected { border-color: var(--alert); color: var(--alert); }
  .chip--converging { border-color: var(--warn, #d9480f); color: var(--warn, #d9480f); }
  .decisions, .utterances, .claims { margin: 0; padding-left: 18px; font-size: 13px; }
  .decisions li, .utterances li { margin-bottom: 10px; }
  .claims { padding-left: 16px; margin-top: 6px; }
  .round { border-left: 2px solid var(--steel-800); padding-left: 10px; }
</style>
