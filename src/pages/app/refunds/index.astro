---
import ConsoleLayout from '../../../layouts/ConsoleLayout.astro';
import RefundOps from '../../../islands/RefundOps';
import { getContext } from '../../../server/context.js';

const session = Astro.locals.session!;

let refunds: any[] = [];
let loadError = '';
try {
  const body = await getContext().commerce.listRefunds();
  refunds = body.refunds as any[];
} catch (thrown) {
  loadError = thrown instanceof Error ? thrown.message : String(thrown);
}

function fmt(iso?: string): string {
  if (!iso) return '—';
  const d = new Date(iso);
  return Number.isNaN(d.getTime()) ? iso : d.toLocaleString('zh-CN', { hour12: false });
}
---
<ConsoleLayout title="退款" session={session}>
  <RefundOps client:load />

  {loadError ? <div class="panel panel--error"><p>退款列表加载失败（上游不可达）：{loadError}</p></div> : null}

  <div class="panel">
    <h3>退款单列表（commerce GET /api/v1/refunds，共 {refunds.length} 条）</h3>
    {refunds.length === 0 ? <p class="hint">暂无退款单。</p> : (
      <table class="data-table">
        <thead><tr>
          <th scope="col">退款单</th><th scope="col">订单</th><th scope="col">原因</th><th scope="col">状态</th>
          <th scope="col">决策</th><th scope="col">渠道退款</th><th scope="col">创建</th><th scope="col">决定</th>
        </tr></thead>
        <tbody>
          {refunds.map((r: any) => (
            <tr>
              <td class="mono">{r.id}</td>
              <td class="mono">{r.orderId}</td>
              <td>{r.reason}</td>
              <td><span class={`status status--${r.status}`}>{r.status}</span></td>
              <td class="mono">{r.decisionId ?? '—'}</td>
              <td class="mono">{r.externalRefundRef ?? '—'}</td>
              <td class="mono">{fmt(r.createdAt)}</td>
              <td class="mono">{fmt(r.decidedAt)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>
</ConsoleLayout>
<style>
  .panel { padding: 14px 18px; border: var(--hair); border-radius: 8px; background: var(--steel-850); margin-bottom: 14px; }
  .panel--error { border-color: var(--alert); }
  .panel h3 { margin: 0 0 10px; font-size: 14px; }
  .hint { color: var(--ink-dim); font-size: 12px; }
  .mono { font-family: var(--mono); font-size: 12px; }
  .data-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .data-table th { text-align: left; color: var(--ink-faint); font-size: 12px; padding: 6px 8px; border-bottom: var(--hair); }
  .data-table td { padding: 8px; border-bottom: 1px solid var(--steel-800); vertical-align: top; }
  .status { font-family: var(--mono); font-size: 12px; }
  .status--succeeded { color: var(--ok); }
  .status--awaiting_approval { color: var(--power); }
  .status--rejected, .status--failed { color: var(--alert); }
</style>
