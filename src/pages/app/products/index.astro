---
import ConsoleLayout from '../../../layouts/ConsoleLayout.astro';
import ProductOps from '../../../islands/ProductOps';
import { getContext } from '../../../server/context.js';
import { listProducts, listChannelAccounts } from '../../../server/commerce-ops-service.js';

const session = Astro.locals.session!;
let products: any[] = [];
let accounts: any[] = [];
let loadError = '';
try {
  const [p, a] = await Promise.all([
    listProducts(getContext()),
    listChannelAccounts(getContext()),
  ]);
  products = (p as any).products;
  accounts = (a as any).accounts;
} catch (thrown) {
  loadError = thrown instanceof Error ? thrown.message : String(thrown);
}
---
<ConsoleLayout title="商品" session={session}>
  {loadError ? <div class="panel panel--error"><p>上游不可达：{loadError}</p></div> : null}

  <ProductOps client:load products={products} accounts={accounts} role={session.role} />

  <div class="panel">
    <h3>商品列表（commerce 透传）</h3>
    {products.length === 0 ? <p class="hint">暂无商品，先在上方创建。</p> : (
      <table class="data-table">
        <thead><tr><th>ID</th><th>标题</th><th>状态</th><th>渠道账号</th><th>SKU</th><th>详情</th></tr></thead>
        <tbody>
          {products.map((p: any) => (
            <tr>
              <td class="mono">{p.id}</td>
              <td>{p.title}</td>
              <td><span class={`status status--${p.status === 'listed' ? 'decided' : 'awaiting_approval'}`}>{p.status}</span></td>
              <td class="mono">{p.channelAccountId ?? '—'}</td>
              <td>{(p.skus ?? []).map((s: any) => `${s.skuCode} ¥${s.price}`).join('；')}</td>
              <td><a class="btn btn--ghost btn--sm" href={`/app/products/${p.id}`}>详情</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>
</ConsoleLayout>
<style>
  .panel { padding: 14px 18px; border: var(--hair); border-radius: 8px; background: var(--steel-850); margin-bottom: 14px; }
  .panel--error { border-color: var(--alert); }
  .panel h3 { margin: 0 0 10px; font-size: 14px; }
  .hint { color: var(--ink-dim); font-size: 12px; }
  .mono { font-family: var(--mono); font-size: 12px; }
  .data-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .data-table th { text-align: left; color: var(--ink-faint); font-size: 12px; padding: 6px 8px; border-bottom: var(--hair); }
  .data-table td { padding: 8px; border-bottom: 1px solid var(--steel-800); vertical-align: top; }
</style>
