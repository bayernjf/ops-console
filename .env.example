# ops-console local configuration.
# Copy to .env and adjust. NEVER commit .env (gitignored). No real secrets in
# the repository: these are local-dev placeholders only.

# ---- Single SSR process (Astro node adapter) ----
OPS_HOST=127.0.0.1
OPS_PORT=3022
# REQUIRED (server refuses to start without it). Secret used to sign the
# httpOnly session cookie (HMAC). Long random value.
OPS_SESSION_SECRET=dev-only-change-me-to-a-long-random-string
# Role mapping seam reserved for production (Cloudflare Access / GitHub OIDC).
# Only `local` is implemented in this milestone; cf/oidc are documented seams.
OPS_AUTH_MODE=local

# ---- Console role passwords (no user table, no registration; local mode) ----
# REQUIRED: both passwords must be set; there are no insecure built-in defaults.
OPS_OWNER_USERNAME=owner
OPS_OWNER_PASSWORD=owner-change-me
OPS_OPERATOR_USERNAME=operator
OPS_OPERATOR_PASSWORD=operator-change-me

# ---- Upstream: zeus decision/org API ----
ZEUS_BASE_URL=http://127.0.0.1:3020
# REQUIRED (server refuses to start without it).
ZEUS_INTERNAL_TOKEN=local-zeus-token

# ---- Upstream: commerce-os API ----
COMMERCE_BASE_URL=http://127.0.0.1:3021
# REQUIRED (server refuses to start without it).
COMMERCE_API_TOKEN=local-commerce-token

# ---- Public base URL used to build approval deep links ----
OPS_PUBLIC_BASE_URL=http://127.0.0.1:3022

# ---- Notifications (T-M8-05) ----
# Local fake webhook receiver (scripts/fake-webhook-receiver). Real Feishu /
# WeChat / email webhook URLs are external and never committed.
OPS_NOTIFY_WEBHOOK_URL=http://127.0.0.1:3023/hook
OPS_NOTIFY_POLL_MS=5000
OPS_NOTIFY_LIST_REFRESH_MS=20000
OPS_NOTIFY_ESCALATION_MINUTES=15
OPS_NOTIFY_ENABLED=true
OPS_NOTIFY_STORE_FILE=./data/notify-deliveries.jsonl

# ---- Local fake webhook receiver ----
WEBHOOK_RECEIVER_PORT=3023
WEBHOOK_RECEIVER_FILE=./data/fake-webhook-received.jsonl

# ---- Inbound zeus decision-event webhook (zeus -> console) ----
# Shared HMAC secret; must equal zeus's ZEUS_DECISION_WEBHOOK_SECRET. Empty
# makes the receiver fail closed (503). The endpoint
# /api/inbound/zeus/decision-webhook is public on purpose (HMAC-authed).
OPS_DECISION_WEBHOOK_SECRET=local-decision-webhook-secret-change-me
OPS_DECISION_WEBHOOK_LOG=./data/inbound-decision-events.jsonl
